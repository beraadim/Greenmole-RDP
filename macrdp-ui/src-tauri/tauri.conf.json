{
  "$schema": "https://raw.githubusercontent.com/nicedoc/tauri/refs/heads/dev/crates/tauri-schema-generator/schemas/config.schema.json",
  "productName": "Greenmole RDP",
  "version": "0.1.32",
  "identifier": "com.macrdp.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Greenmole RDP",
        "width": 960,
        "height": 620,
        "minWidth": 800,
        "minHeight": 500,
        "center": true,
        "decorations": true,
        "resizable": true,
        "visible": true
      },
      {
        "label": "popover",
        "title": "",
        "url": "/popover",
        "width": 300,
        "height": 280,
        "decorations": false,
        "resizable": false,
        "visible": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true
      }
    ],
    "trayIcon": {
      "id": "main-tray",
      "iconPath": "icons/tray.png",
      "iconAsTemplate": false
    },
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "infoPlist": "Info.plist"
    },
    "license": "GPL-3.0-only",
    "resources": {
      "../../LICENSE": "licenses/GPL-3.0.txt",
      "../../NOTICE": "licenses/NOTICE.txt",
      "../../branding/LICENSE": "licenses/Greenmole-artwork/LICENSE",
      "../../branding/NOTICE": "licenses/Greenmole-artwork/NOTICE",
      "../../branding/README.md": "licenses/Greenmole-artwork/README.md",
      "../../crates/macrdp-core/src/handler/layouts/LICENSE-APACHE": "licenses/Keyboard-layouts/LICENSE-APACHE",
      "../../crates/macrdp-core/src/handler/layouts/NOTICE": "licenses/Keyboard-layouts/NOTICE"
    }
  }
}
